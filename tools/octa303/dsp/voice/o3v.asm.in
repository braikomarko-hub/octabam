; o3v -- OCTA303 vFable, the 303 voice on the DSP (17 Nov 2026, written by Claude): the neutral voice's per-sample
; part as an FX insert.  NOT a module of an image yet: it runs on tools/octa303/dsp/host/o3host.cpp against the
; reference o3d_sample (tools/octa303/dsp/ref/o3k.c).
; In:  x:(r0) = 16 interleaved L/R samples.  L = the oscillator (x << 2, through the gain ahead of FX1).
;      R = sixteen 15-bit payloads p, each sent as p*256+128: 0 the mark $7fff (the largest value: the first to
;      decode wrong if the gain ahead of FX1 is not the settled one); 1..14 = g1 g2 g3 g4 kq dq gt as (bits 22..8,
;      bits 7..0); 15 = the sum of payloads 1..14, 15 bits.  x:(r6+0) = gv >> 1 as a record halfword (<< 8).
;      x:(r6+3) = the track's AMP VOL halfword (<< 8): the output is the voice x 4 x (VOL / $7f00)^2.
;      x:(r6+1), x:(r6+2) = $3a5c00, $651700: the engine's signature in the voice record.  Without it the track is not
;      an OCTA-303: the audio is left exactly as it came (Marko, 17 Nov 2026).
;      A frame is taken only if the mark, the sum and the seven low-byte payloads (nothing above bit 7) all agree.
; Out: L = R = the voice.  A refused frame is silenced (the payloads must never reach the output) and the gain
;      restarts from 0, so the voice ramps in when the frames are good again.
; State at x:(r7): 0..5 s1 s2 s3 s4 lp lp2; 6 the output's gain (VOL^2); 7,8 the gain (48 bits); 9,$a its step;
; $b.. g1 g2 g3 g4 kq dq gh gv gt; $20..$2f the decoded payloads.
; An address register written by a move is not used in the next two instructions (MODULES.md, the rules for DSP code;
; agu_check.py checks the listing).  The ceiling's two tables (98 entries each) are in P.
; CYCLES_FORWARD_BRANCHES
init:
        move    #>$ffffff,m5                    ; not guaranteed linear at init (DSP.md)
        move    r7,r5
        clr     a
        do      #$30,o3v_izero
        move    a,x:(r5)+
o3v_izero:
        move    #>$11,n5
        move    r7,r5
        move    #>@GH@,x0
        clr     a
        move    (r5)+n5
        move    x0,x:(r5)+                      ; gh, a constant of the laws
        rts
proc:
        move    #>$ffffff,m1
        move    #>$ffffff,m2
        move    #>$ffffff,m3
        move    #>$ffffff,m4
        move    #>$ffffff,m5
        move    r6,r1
        move    r7,r2
        move    #>6,n2
        move    (r1)+
        move    x:(r1)+,a
        move    #>$3a5c00,x0
        cmp     x0,a
        bne     o3v_pass                        ; not an OCTA-303 track: nothing is touched
        move    x:(r1),a
        move    #>$651700,x0
        cmp     x0,a
        bne     o3v_pass
        move    (r1)+
        move    x:(r1),x0                       ; AMP VOL
        mpy     x0,x0,a
        move    (r2)+n2
        move    a,x:(r2)+                       ; (VOL / $8000)^2
; ---- the sixteen payloads: p = (y + y * 672 * 2^-23) >> 8 ----------------------------------------------------
        move    r0,r1
        move    r7,r2
        move    #>$20,n2
        move    #>672,y1
        move    (r1)+                           ; R of sample 0
        move    (r2)+n2
        do      #16,o3v_dec
        move    x:(r1)+,x0
        move    x0,a
        mac     x0,y1,a
        move    (r1)+
        asr     #8,a,a
        move    a1,x:(r2)+
o3v_dec:
        move    r7,r2
        move    #>$7fff,x0
        clr     b
        move    (r2)+n2                         ; r2 = the payloads
        move    x:(r2)+,a
        cmp     x0,a
        bne     o3v_bad
        do      #14,o3v_sum
        move    x:(r2)+,x0
        add     x0,b
o3v_sum:
        move    #>$7fff,x0
        and     x0,b
        move    x:(r2),x0
        cmp     x0,b
        bne     o3v_bad
        move    #>$21,n2
        move    r7,r2
        clr     b
        clr     a
        move    (r2)+n2                         ; r2 = payload 1
        do      #7,o3v_low                      ; the seven low bytes: nothing above bit 7
        move    x:(r2)+,x0
        move    x:(r2)+,a
        and     #>$7f00,a
        add     a,b
o3v_low:
        tst     b
        bne     o3v_bad
; ---- seven 23-bit numbers: (hi << 8) + lo ----------------------------------------------------------------
        move    #>$b,n5
        move    r7,r2
        move    r7,r5
        clr     a
        move    (r2)+n2                         ; r2 = payload 1
        move    (r5)+n5                         ; r5 = g1
        do      #6,o3v_asm
        move    x:(r2)+,a
        asl     #8,a,a
        move    x:(r2)+,x0
        add     x0,a
        move    a1,x:(r5)+
o3v_asm:
        move    x:(r2)+,a
        asl     #8,a,a
        move    x:(r2)+,x0
        add     x0,a                            ; gt
        move    x:(r6),b
        and     #>$ffff00,b                     ; (an LFO's fraction never reaches gv)
        asr     #7,b,b                          ; gv
        move    (r5)+                           ; past gh
        move    b,x:(r5)+                       ; (gv: b1 alone, positive)
        move    a1,x:(r5)
; ---- the gain's step: (gt - gain) >> 4, 48 bits -----------------------------------------------------------
        move    #>7,n2
        move    r7,r2
        move    x:(r5),a
        clr     b
        move    (r2)+n2                         ; r2 = the gain
        move    x:(r2)+,b
        move    x:(r2)+,b0
        sub     b,a
        asr     #4,a,a
        move    a1,x:(r2)+
        move    a0,x0
        move    x0,x:(r2)
        move    #>$b,n5
        move    r7,r2
        move    r7,r5
        move    r7,r1                           ; r1 = s1
        move    (r2)+n2                         ; r2 = the gain, for the loop
        move    (r5)+n5                         ; r5 = g1
        move    r5,r3                           ; r3 = g1, kept
        move    #>2,n5
        do      n7,o3v_end
; ---- zero-input pass --------------------------------------------------------------------------------------
        move    x:(r1)+,x0
        move    x:(r5)+,y1
        move    x0,a
        mac     -x0,y1,a
        move    x:(r1)+,x1
        sub     x1,a
        move    x:(r5)+,y1
        move    a,x0
        move    x1,a
        mac     x0,y1,a
        move    x:(r1)+,x1
        sub     x1,a
        move    x:(r5)+,y1
        move    a,x0
        move    x1,a
        mac     x0,y1,a
        move    x:(r1)+,x1
        sub     x1,a
        move    x:(r5)+,y1
        move    a,x0
        move    x1,a
        mac     x0,y1,a                         ; z
        move    x:(r1)+,x1                      ; lp
        sub     x1,a
        move    x:(r5)+,y1                      ; kq
        move    a,x0
        mpy     x0,y1,a
        move    x:(r5)+,y1                      ; dq
        asl     #7,a,a
        move    x:(r0),b                        ; the oscillator, x << 2
        asr     #2,b,b
        sub     a,b
        move    r7,r1
        move    r3,r5
        move    b,x0
        mpy     x0,y1,a                         ; u
; ---- four poles: v = (in - s) g, y = s + v, s = y + v --------------------------------------------------------
        move    x:(r1),x1
        sub     x1,a
        move    x:(r5)+,y1
        move    a,x0
        mpy     x0,y1,a
        tfr     a,b
        add     x1,a
        add     a,b
        move    b,x:(r1)+
        move    x:(r1),x1
        sub     x1,a
        move    x:(r5)+,y1
        move    a,x0
        mpy     x0,y1,a
        tfr     a,b
        add     x1,a
        add     a,b
        move    b,x:(r1)+
        move    x:(r1),x1
        sub     x1,a
        move    x:(r5)+,y1
        move    a,x0
        mpy     x0,y1,a
        tfr     a,b
        add     x1,a
        add     a,b
        move    b,x:(r1)+
        move    x:(r1),x1
        sub     x1,a
        move    x:(r5)+,y1
        move    a,x0
        mpy     x0,y1,a
        tfr     a,b
        add     x1,a
        add     a,b
        move    b,x:(r1)+
; ---- the loop's high-pass ---------------------------------------------------------------------------------
        move    a,y0                            ; y4
        move    (r5)+n5                         ; r5 = gh
        move    x:(r1),x1
        sub     x1,a
        move    x:(r5)+,y1
        move    a,x0
        mpy     x0,y1,a
        tfr     a,b
        add     x1,a
        add     a,b
        move    b,x:(r1)+
        neg     a
        add     y0,a                            ; hp = y4 - lo
; ---- the VCA input's high-pass ------------------------------------------------------------------------------
        move    a,y0
        move    x:(r1),x1
        sub     x1,a
        move    x:(r5)+,y1
        move    a,x0
        mpy     x0,y1,a
        tfr     a,b
        add     x1,a
        add     a,b
        move    b,x:(r1)+
        move    y0,b
        sub     a,b                             ; v
        move    b,x0
; ---- the VCA: gain += step (48 bits), y = v gain << 3 ----------------------------------------------------------
        move    x:(r2)+,a
        move    x:(r2)+,a0
        move    x:(r2)+,b
        move    x:(r2)-,b0
        add     b,a
        move    (r2)-
        move    a0,y1                           ; (x0 holds v)
        move    y1,x:(r2)-
        move    a1,x:(r2)
        move    a1,y1
        mpy     x0,y1,a
        asl     #3,a,a
; ---- the BA662's ceiling: two tables in P, 98 entries each, step 2^14 (the idiom of fet76's f76_tab) -----------
        move    a,x1                            ; y, limited: its sign and its integer part
        move    x1,a
        abs     a
        move    #>@LIM@,x0
        move    #>@LIM@,b
        cmp     a,b
        tlt     x0,a                            ; |y| above the table's end: the end
        move    a,y0
        asr     #14,a,a
        move    a1,n5
        move    #>@PT@,r5
        move    x1,b
        tst     b
        bge     o3v_pos
        move    #>@PTN@,r5                      ; the negative side's table
o3v_pos:
        move    y0,a
        and     #>$3fff,a
        asl     #9,a,a
        move    a,x0                            ; the fraction, 23 bits
        move    (r5)+n5
        move    p:(r5)+,y0                      ; (fet76's two reads)
        move    p:(r5),b
        move    y0,a
        sub     a,b
        move    b,y1
        mpy     x0,y1,a
        add     y0,a
        move    x1,b
        tst     b
        bge     o3v_sgn
        neg     a
o3v_sgn:
        move    a,x0                            ; y
        move    x:(r1),y1                       ; VOL^2: r1 is past lp2, on it
        mpy     x0,y1,a
        asl     #3,a,a
        move    a,x0
        move    #>@CV@,y1
        mpy     x0,y1,a                         ; x 4 x ($8000 / $7f00)^2
        move    a,x0
        move    r7,r1
        move    r3,r5
        move    #>2,n5
        move    x0,x:(r0)+
        move    x0,x:(r0)+
o3v_end:
o3v_pass:
        rts
o3v_bad:
        move    #>7,n2
        move    r7,r2
        clr     a
        clr     b
        move    (r2)+n2
        do      #4,o3v_gz                       ; the gain and its step: the voice ramps in from 0 afterwards
        move    a,x:(r2)+
o3v_gz:
        do      #32,o3v_mute
        move    a,x:(r0)+
o3v_mute:
        rts
