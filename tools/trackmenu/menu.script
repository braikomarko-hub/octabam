# tools/emu/live_shots.py trackmenu --script tools/trackmenu/menu.script --output-dir <dir>
# The TRACK MENU v1 on the port: a short tap does nothing, the long press opens the chooser, YES
# opens a function's page (the stock knobs), NO goes back, the same track key starts and closes,
# reopening lands on the function last used, and MORPH's own window still opens with [TRACK]+[UP].
# The holds are long (8 s): on a slow machine the port runs slower than the wall clock.
shot trackmenu/00_main
key 0x14
shot trackmenu/01_short_tap_nothing
hold 0x14
wait 8
shot trackmenu/02_long_press_chooser
release 0x14
wait 1
shot trackmenu/03_released_still_open
key 0x20
shot trackmenu/04_chooser_euclacid
key 0x31
wait 1
shot trackmenu/05_euclacid_page
enc 0 3
enc 4 2
shot trackmenu/06_euclacid_knobs
key 0x31
shot trackmenu/07_print_flash
key 0x21
wait 1
shot trackmenu/08_euclacid_setup
key 0x32
wait 1
shot trackmenu/09_no_back_to_chooser
key 0x33
key 0x31
wait 1
shot trackmenu/10_morph_page
enc 0 4
enc 2 1
shot trackmenu/11_morph_knobs
key 0x32
key 0x20
key 0x20
key 0x31
wait 1
shot trackmenu/12_ergosum_page
enc 1 3
enc 0 2
shot trackmenu/13_ergosum_knobs
key 0x13
shot trackmenu/14_other_track_swallowed
key 0x14
wait 1
shot trackmenu/15_same_track_start
wait 10
hold 0x14
wait 8
release 0x14
wait 1
shot trackmenu/16_reopen_on_ergosum
key 0x32
wait 1
shot trackmenu/17_no_closes
chord 0x14 0x33
shot trackmenu/18_morph_window_still_works
key 0x32
quit
